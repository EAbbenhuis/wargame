# Kopieer dit bestand naar .env en vul je eigen sleutel in. Zet .env NOOIT in git (staat in .gitignore).
# Zonder sleutel werkt het hele spel gewoon; alleen de staf "met taalmodel" staat dan uit.

# Sleutel van https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model voor de AI-staf. Standaard: anthropic/claude-haiku-4.5 (goedkoop, capabel).
# Andere voorbeelden: google/gemini-2.5-flash, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Poort van de staf-server (de web-app stuurt /api door naar deze poort)
STAFF_PORT=8787
