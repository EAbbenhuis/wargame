{
  "name": "wargame",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/web",
    "packages/server"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c blue,gray \"npm run dev -w @wargame/web\" \"npm run dev -w @wargame/server\"",
    "dev:web": "npm run dev -w @wargame/web",
    "build": "npm run build -w @wargame/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run e2e -w @wargame/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
